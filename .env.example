# Konfigurasi database Turso (biarkan kosong untuk mode lokal berbasis file SQLite).
#
# Untuk produksi (Vercel), isi dengan connection string dari dashboard/CLI Turso:
#   TURSO_DATABASE_URL=libsql://nama-database-org.turso.io
#   TURSO_AUTH_TOKEN=isi-token-dari-turso
#
# Jika kedua variabel di atas dikosongkan, aplikasi otomatis memakai file
# SQLite lokal di ./data/app.db (cocok untuk development di komputer sendiri).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
